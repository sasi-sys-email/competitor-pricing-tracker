# --- Supabase Auth (production) ---
# Project Settings → API. Leave blank only for the local Postgres demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Postgres ---
# Supabase: Project Settings → Database → direct connection, or the session
# pooler on port 5432. Do not use the transaction pooler (port 6543): each
# request runs SET LOCAL ROLE inside a transaction.
# The database user must bypass RLS for the daily cron (the Supabase
# `postgres` user does). User requests switch to role `authenticated`.
DATABASE_URL=

# Public origin used in email history links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Resend (change alerts only; magic-link mail is Supabase) ---
RESEND_API_KEY=
# Until a domain is verified, Resend only delivers to the account owner.
# Example: Pricing Tracker <onboarding@resend.dev>
RESEND_FROM_EMAIL=

# --- Local demo only. Never set these on Vercel. ---
# LOCAL_AUTH=1 prints the magic link on the login page (no Inbucket/Docker).
LOCAL_AUTH=
# openssl rand -hex 32
LOCAL_AUTH_SECRET=
